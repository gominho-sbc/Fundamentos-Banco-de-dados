        <mxCell id="brrQAnaPlsISC2a0XBrS-34" edge="1" parent="1" source="brrQAnaPlsISC2a0XBrS-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=gap;endArrow=none;endFill=0;" target="brrQAnaPlsISC2a0XBrS-28">
