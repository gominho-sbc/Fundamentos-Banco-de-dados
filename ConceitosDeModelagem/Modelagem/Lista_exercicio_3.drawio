<mxfile host="Electron" pages="5">
  <diagram id="QWJO1fAmhtrf9V_ukzX2" name="exercicio-1">
    <mxGraphModel dx="922" dy="832" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="CuEHlAc23hKp-LwonMK6-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2&gt;LISTA 3  - Cardinalidades&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Exercício 1 — Qual a cardinalidade máxima?&lt;/strong&gt; Classifique como &lt;em&gt;1:1, 1:N&lt;/em&gt; ou &lt;em&gt;N:N&lt;/em&gt;:&lt;/p&gt;&lt;ol&gt;&lt;br&gt;&lt;li&gt;Um país tem uma única capital, e cada capital é de um único país. (1,1)&lt;/li&gt;&lt;br&gt;&lt;li&gt;Um time tem vários jogadores; cada jogador joga em um único time. (1,N) - (1,1) = (1,N)&lt;/li&gt;&lt;br&gt;&lt;li&gt;Um ator atua em vários filmes, e um filme tem vários atores. (1,N) - (1,N) = (N,N)&lt;/li&gt;&lt;br&gt;&lt;li&gt;Um cliente faz vários pedidos; cada pedido é de um único cliente. (0,N) - (1,1) = (1, N)&lt;/li&gt;&lt;br&gt;&lt;li&gt;Cada carro tem uma única placa, e cada placa pertence a um único carro. (0,1) - (1,1) = (1,1)&lt;/li&gt;&lt;br&gt;&lt;li&gt;Um médico atende vários pacientes, e um paciente pode ser atendido por vários médicos. (0, N) - (1,N) = (N, N)&lt;/li&gt;&lt;br&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="350" width="760" x="40" y="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="exercicio-2" id="ccGTYpjciLBOGAAlaNU-">
    <mxGraphModel dx="922" dy="832" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="gqGaxrVrckojdQNsCXqI-0" />
