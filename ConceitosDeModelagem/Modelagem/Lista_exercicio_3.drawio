        <mxCell id="8dQBuMzq6fntnnTQTqLv-0" />
        <mxCell id="8dQBuMzq6fntnnTQTqLv-1" parent="8dQBuMzq6fntnnTQTqLv-0" />
        <mxCell id="8dQBuMzq6fntnnTQTqLv-2" parent="8dQBuMzq6fntnnTQTqLv-1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2&gt;LISTA 3  - Cardinalidades&lt;/h2&gt;&lt;ol&gt;&lt;p&gt;&lt;strong&gt;Exercício 4 — Desafio: Empresa (continuação da Aula 02).&lt;/strong&gt; Abra o DER do exercício 6 da Aula 02 e acrescente as cardinalidades:&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;Cada funcionário trabalha em exatamente um departamento, e um departamento tem um ou mais funcionários. Cada departamento é gerenciado por exatamente um funcionário, e um funcionário gerencia no máximo um departamento (a maioria não gerencia nenhum). Um funcionário tem no máximo um chefe (o diretor não tem) e pode supervisionar vários funcionários ou nenhum. Um funcionário participa de nenhum ou vários projetos, e cada projeto tem pelo menos um funcionário.&lt;/p&gt;&lt;/blockquote&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="180" width="760" x="40" y="40" as="geometry" />
        </mxCell>
