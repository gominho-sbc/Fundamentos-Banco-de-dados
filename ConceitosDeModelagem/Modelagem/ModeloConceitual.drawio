  <diagram id="Ziu9CkIuRSilye6jR8-O" name="exercicio-5">
    <mxGraphModel dx="1178" dy="619" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="7Orpl9ws-kSIihbcEybC-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p&gt;&lt;strong&gt;Exercício 5 - Clínica Veterinária.&lt;/strong&gt; Mesma tarefa do exercício 4:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Uma clínica veterinária atende animais trazidos por seus tutores. Do &lt;b&gt;tutor&lt;/b&gt;, a clínica guarda CPF, nome, telefones e endereço (rua, número e cidade). Cada animal recebe um código e tem nome, espécie, raça e data de nascimento; a recepção quer ver a idade do animal. A clínica também cadastra os veterinários, identificados pelo CRMV, com nome e as especialidades de cada um (um veterinário pode ter várias).&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="760" x="34" y="50" as="geometry" />
        </mxCell>
