        <mxCell id="fQby4PRt0QobKTUNRQr0-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p&gt;&lt;strong&gt;Exercício 6 - Desafio: CLIENTE com todos os tipos de atributo.&lt;/strong&gt; Desenhe no &lt;a href=&quot;http://draw.io&quot;&gt;draw.io&lt;/a&gt; a entidade e marque o tipo de cada atributo:&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;Uma loja virtual precisa cadastrar seus clientes. Cada cliente é identificado pelo CPF. A loja guarda o nome completo (primeiro nome e sobrenome), um ou mais e-mails, o endereço de entrega (rua, número, bairro, cidade e CEP), a data de nascimento e a data de cadastro. O marketing quer saber a idade dos clientes para fazer promoções.&lt;/p&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="750" x="39" y="50" as="geometry" />
        </mxCell>
