<mxfile host="Electron" pages="4">
  <diagram id="VjYvmWBZhoKpYRAa0tkQ" name="exercicio_2">
    <mxGraphModel dx="834" dy="3240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gDUWjgCjhcUsaHjDupja-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h2&gt;Lista 2 - Relacionamentos&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Exercício 1 — Ache os relacionamentos.&lt;/strong&gt; Escreva no formato ENTIDADE — verbo — ENTIDADE:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;O cliente faz pedidos.&amp;nbsp; CLIENTE ---- faz ---- PEDIDO&lt;/li&gt;&lt;br&gt;&lt;li&gt;O motorista dirige um ônibus.&amp;nbsp; MOTORISTA ---- dirige ---- ONIBUS&lt;/li&gt;&lt;br&gt;&lt;li&gt;O autor escreve livros.&amp;nbsp; &amp;nbsp;AUTOR ---- escreve ---- LIVRO&lt;/li&gt;&lt;br&gt;&lt;li&gt;O funcionário trabalha em um departamento.&amp;nbsp; &amp;nbsp;FUNCIONARIO ----trabalha ---- DEPARTAMENTO&lt;/li&gt;&lt;br&gt;&lt;li&gt;O jogador joga em um time.&amp;nbsp; &amp;nbsp;JOGADOR ---- joga ---- TIME&lt;/li&gt;&lt;br&gt;&lt;/ol&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="810" x="20" y="-2160" as="geometry" />
        </mxCell>
        <mxCell id="gDUWjgCjhcUsaHjDupja-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p&gt;&lt;strong&gt;Exercício 2 — De quem é o atributo?&lt;/strong&gt; Diga se é da entidade (qual?) ou do relacionamento:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Nota final (ALUNO cursa DISCIPLINA) - ALUNO&lt;/li&gt;&lt;br&gt;&lt;li&gt;Nome da disciplina (ALUNO cursa DISCIPLINA) - DISCIPLINA&lt;/li&gt;&lt;br&gt;&lt;li&gt;Data do empréstimo (LEITOR empresta LIVRO) - RELACIONAMENTO&lt;/li&gt;&lt;br&gt;&lt;li&gt;Título do livro (LEITOR empresta LIVRO) - LIVRO&lt;/li&gt;&lt;br&gt;&lt;li&gt;Quantidade de itens (PEDIDO contém PRODUTO) - RELACIONAMENTO&lt;/li&gt;&lt;br&gt;&lt;li&gt;CPF do cliente (CLIENTE faz PEDIDO) -&amp;nbsp; CLIENTE&lt;/li&gt;&lt;br&gt;&lt;li&gt;Data do casamento (PESSOA casa com PESSOA) - RELACIONAMENTO&lt;/li&gt;&lt;br&gt;&lt;/ol&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="740" x="50" y="-1930" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
