  <diagram id="SDQh3tBWQSr-QMHDEASy" name="exercicios-1-2">
    <mxGraphModel dx="691" dy="832" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="BZwLeIxjVfuOyULCGfn6-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2&gt;LISTA 4 -  Modelo Lógico&lt;/h2&gt;&lt;h2&gt;Exercicios&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Exercício 1 — Qual regra usar?&lt;/strong&gt; Diga o que cada item vira no modelo lógico:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;O atributo composto &lt;strong&gt;endereço&lt;/strong&gt; (rua, número, bairro) de CLIENTE.&lt;br&gt;R: Vira várias colunas&lt;/li&gt;&lt;br&gt;&lt;li&gt;O atributo multivalorado &lt;strong&gt;telefone&lt;/strong&gt; de CLIENTE.&lt;br&gt;R: Tabela nova&lt;/li&gt;&lt;br&gt;&lt;li&gt;O atributo derivado &lt;strong&gt;idade&lt;/strong&gt; de ALUNO.&lt;br&gt;R: Não vira coluna&lt;/li&gt;&lt;br&gt;&lt;li&gt;CLIENTE (1,1) — faz — (0,N) PEDIDO. Onde fica a FK?&lt;br&gt;R: Pedido&lt;/li&gt;&lt;br&gt;&lt;li&gt;ATOR (1,N) — atua — (1,N) FILME. O que acontece?&lt;br&gt;R: Tabela associativa&lt;/li&gt;&lt;br&gt;&lt;li&gt;FUNCIONARIO supervisiona FUNCIONARIO (cada funcionário tem no máximo um chefe).&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;&lt;strong&gt;Exercício 2 — Serve de PK?&lt;/strong&gt; Diga se serve e por quê:&lt;/p&gt;&lt;ol&gt;&lt;br&gt;&lt;li&gt;Nome do cliente - Não&lt;/li&gt;&lt;br&gt;&lt;li&gt;CPF do cliente - Serve porque é unico para cada individuo&lt;/li&gt;&lt;br&gt;&lt;li&gt;E-mail do cliente - Não&lt;/li&gt;&lt;br&gt;&lt;li&gt;Código do produto - Serve&lt;/li&gt;&lt;br&gt;&lt;li&gt;Data de nascimento - Não&lt;/li&gt;&lt;br&gt;&lt;li&gt;Número do pedido - Não&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;&lt;strong&gt;&lt;br&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;br&gt;&lt;/ol&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1320" width="630" x="40" y="10" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="LpySbngaME6VN8We_mNL" name="exercicio-3">
